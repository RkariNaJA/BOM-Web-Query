# Copy to .env and fill in. .env is git-ignored; this file is the template.

# --- SQL Server ----------------------------------------------------------
# SERVER, DATABASE and VIEW are required; the app refuses to start without them.
BOM_DB_DRIVER=ODBC Driver 17 for SQL Server
BOM_DB_SERVER=HOSTNAME\INSTANCE
BOM_DB_DATABASE=
BOM_DB_SCHEMA=dbo
BOM_DB_VIEW=

# --- Authentication ------------------------------------------------------
# Left blank, the app uses Windows (Trusted) auth. Fill both in only to switch
# to SQL Server authentication.
BOM_DB_USER=
BOM_DB_PASSWORD=
